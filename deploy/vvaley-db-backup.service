[Unit]
Description=Valira Valley — copia diaria (base en RDS + imágenes subidas)
# La base está en Amazon RDS: solo hace falta red, no un Postgres local.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Corre como el dueño del .env (chmod 600) y de public/uploads.
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/sbin/vvaley-db-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
