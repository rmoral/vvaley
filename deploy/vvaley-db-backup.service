[Unit]
Description=Valira Valley — Postgres daily backup
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/vvaley-db-backup
# Don't fail the timer if a single run hits a transient error.
SuccessExitStatus=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
