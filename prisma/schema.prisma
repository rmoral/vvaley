// Valira Valley — schema
// Prisma + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id              String              @id @default(cuid())
  email           String              @unique
  name            String?
  passwordHash    String
  role            UserRole            @default(EDITOR)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  posts           Post[]
  news            News[]
  events          Event[]
  campaigns       Campaign[]
  socialAccounts  SocialAccount[]
  socialPublications SocialPublication[]
}

// ---------- Podcast ---------- //

enum GuestStatus {
  PROPOSED
  CONFIRMED
  RECORDED
  DECLINED
}

model Guest {
  id          String         @id @default(cuid())
  slug        String         @unique
  fullName    String
  headline    String?
  company     String?
  role        String?
  bio         String?
  photoUrl    String?
  email       String?
  website     String?
  linkedin    String?
  twitter     String?
  instagram   String?
  isPublic    Boolean        @default(true)
  status      GuestStatus    @default(PROPOSED)
  scheduledAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  episodes    EpisodeGuest[]

  @@index([fullName])
  @@index([status, scheduledAt])
}

enum EpisodeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum EpisodePillar {
  ECONOMY
  COMPANY
  ENTREPRENEURSHIP
  TECH
}

model Episode {
  id              String         @id @default(cuid())
  slug            String         @unique
  number          Int?           @unique
  title           String
  subtitle        String?
  summary         String?
  showNotes       String?
  pillar          EpisodePillar?
  durationSec     Int?
  audioUrl        String?
  coverImageUrl   String?
  spotifyUrl      String?
  appleUrl        String?
  youtubeUrl      String?
  status          EpisodeStatus  @default(DRAFT)
  recordingAt     DateTime?
  recordingUrl    String?
  inviteSentAt    DateTime?
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  guests          EpisodeGuest[]

  @@index([status, publishedAt])
  @@index([recordingAt])
}

model EpisodeGuest {
  episodeId String
  guestId   String
  position  Int      @default(0)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@id([episodeId, guestId])
  @@index([guestId])
}

// ---------- Newsletter ---------- //

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  locale         String           @default("es")
  status         SubscriberStatus @default(PENDING)
  confirmToken   String?          @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  source         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model Campaign {
  id              String         @id @default(cuid())
  subject         String
  preheader       String?
  bodyMarkdown    String         @db.Text
  status          CampaignStatus @default(DRAFT)
  /// Optional locale filter — null = all locales.
  audienceLocale  String?
  recipients      Int            @default(0)
  delivered       Int            @default(0)
  failed          Int            @default(0)
  sentAt          DateTime?
  authorId        String?
  author          User?          @relation(fields: [authorId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, sentAt])
}

// ---------- Blog ---------- //

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Post {
  id            String            @id @default(cuid())
  slug          String            @unique
  status        PostStatus        @default(DRAFT)
  authorId      String?
  author        User?             @relation(fields: [authorId], references: [id])
  coverImageUrl String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  translations  PostTranslation[]

  @@index([status, publishedAt])
}

model PostTranslation {
  id      String  @id @default(cuid())
  postId  String
  locale  String
  title   String
  summary String?
  body    String  @db.Text

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([locale])
}

// ---------- News ---------- //

enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model News {
  id            String            @id @default(cuid())
  slug          String            @unique
  status        NewsStatus        @default(DRAFT)
  authorId      String?
  author        User?             @relation(fields: [authorId], references: [id])
  coverImageUrl String?
  externalUrl   String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  translations  NewsTranslation[]

  @@index([status, publishedAt])
}

model NewsTranslation {
  id      String  @id @default(cuid())
  newsId  String
  locale  String
  title   String
  summary String?
  body    String? @db.Text

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, locale])
  @@index([locale])
}

// ---------- Events ---------- //

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventLocationType {
  ONLINE
  INPERSON
  HYBRID
}

enum RegistrationStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
}

model Event {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  status               EventStatus         @default(DRAFT)
  locationType         EventLocationType   @default(INPERSON)
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String              @default("Europe/Andorra")
  venueName            String?
  venueAddress         String?
  onlineUrl            String?
  capacity             Int?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  coverImageUrl        String?
  authorId             String?
  author               User?               @relation(fields: [authorId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  translations         EventTranslation[]
  registrations        EventRegistration[]

  @@index([status, startsAt])
}

model EventTranslation {
  id          String  @id @default(cuid())
  eventId     String
  locale      String
  title       String
  summary     String?
  description String? @db.Text

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
  @@index([locale])
}

model EventRegistration {
  id        String             @id @default(cuid())
  eventId   String
  email     String
  fullName  String
  company   String?
  notes     String?
  locale    String             @default("es")
  status    RegistrationStatus @default(CONFIRMED)
  createdAt DateTime           @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId, status])
}

// ---------- Social publishing ---------- //

enum SocialProvider {
  LINKEDIN
  X
  INSTAGRAM
  TIKTOK
}

enum SocialPublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model SocialAccount {
  id            String         @id @default(cuid())
  provider      SocialProvider
  /// External user/page id from the provider (e.g. "urn:li:person:..." for LinkedIn).
  externalId    String
  /// Display name shown in the admin (e.g. "Valira Valley · LinkedIn").
  displayName   String
  avatarUrl     String?
  accessToken   String         @db.Text
  refreshToken  String?        @db.Text
  /// null = never expires (rare).
  expiresAt     DateTime?
  scope         String?
  /// Soft-disconnect: keeps publication history attached to the account.
  isActive      Boolean        @default(true)
  connectedById String?
  connectedBy   User?          @relation(fields: [connectedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  targets       SocialPublicationTarget[]

  @@unique([provider, externalId])
  @@index([provider, isActive])
}

model SocialPublication {
  id          String                    @id @default(cuid())
  body        String                    @db.Text
  mediaUrls   String[]                  @default([])
  /// Permalink to the page on our site this announces (optional).
  sourceUrl   String?
  status      SocialPublicationStatus   @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  /// Optional informational links to the source content (not enforced).
  episodeId   String?
  postId      String?
  newsId      String?
  eventId     String?
  authorId    String?
  author      User?                     @relation(fields: [authorId], references: [id])
  targets     SocialPublicationTarget[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([status, scheduledAt])
}

/// One row per (publication, account). Stores the per-target outcome so
/// posting to LinkedIn can succeed while X fails on the same publication.
model SocialPublicationTarget {
  publicationId String
  accountId     String
  status        SocialPublicationStatus @default(DRAFT)
  /// Provider-side post id (e.g. LinkedIn URN).
  externalId    String?
  /// Public permalink to the post on the provider.
  externalUrl   String?
  attempts      Int                     @default(0)
  lastError     String?                 @db.Text
  publishedAt   DateTime?
  updatedAt     DateTime                @updatedAt

  publication SocialPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  account     SocialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([publicationId, accountId])
  @@index([accountId])
}
