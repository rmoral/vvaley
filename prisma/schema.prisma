// Valira Valley — schema
// Prisma + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  passwordHash       String
  role               UserRole            @default(EDITOR)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  posts              Post[]
  news               News[]
  events             Event[]
  campaigns          Campaign[]
  socialAccounts     SocialAccount[]
  socialPublications SocialPublication[]
  eventEmailSends    EventEmailSend[]
}

// ---------- Podcast ---------- //

enum GuestStatus {
  PROPOSED
  CONFIRMED
  RECORDED
  DECLINED
}

model Guest {
  id          String         @id @default(cuid())
  slug        String         @unique
  fullName    String
  headline    String?
  company     String?
  role        String?
  bio         String?
  photoUrl    String?
  email       String?
  website     String?
  linkedin    String?
  twitter     String?
  instagram   String?
  isPublic    Boolean        @default(true)
  status      GuestStatus    @default(PROPOSED)
  scheduledAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  episodes    EpisodeGuest[]
  events      Event[]

  @@index([fullName])
  @@index([status, scheduledAt])
}

enum EpisodeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum EpisodePillar {
  ECONOMY
  COMPANY
  ENTREPRENEURSHIP
  TECH
}

model Episode {
  id            String         @id @default(cuid())
  slug          String         @unique
  number        Int?           @unique
  title         String
  subtitle      String?
  summary       String?
  showNotes     String?
  pillar        EpisodePillar?
  durationSec   Int?
  audioUrl      String?
  coverImageUrl String?
  spotifyUrl    String?
  appleUrl      String?
  youtubeUrl    String?
  status        EpisodeStatus  @default(DRAFT)
  recordingAt   DateTime?
  recordingUrl  String?
  inviteSentAt  DateTime?
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  guests        EpisodeGuest[]

  @@index([status, publishedAt])
  @@index([recordingAt])
}

model EpisodeGuest {
  episodeId String
  guestId   String
  position  Int     @default(0)
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  guest     Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@id([episodeId, guestId])
  @@index([guestId])
}

// ---------- Newsletter ---------- //

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  locale         String           @default("es")
  status         SubscriberStatus @default(PENDING)
  confirmToken   String?          @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  source         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model Campaign {
  id             String         @id @default(cuid())
  subject        String
  preheader      String?
  bodyMarkdown   String         @db.Text
  status         CampaignStatus @default(DRAFT)
  /// Optional locale filter — null = all locales.
  audienceLocale String?
  recipients     Int            @default(0)
  delivered      Int            @default(0)
  failed         Int            @default(0)
  sentAt         DateTime?
  /// When true, surfaced under /newsletter/archivo once SENT. Editors can
  /// keep internal-only campaigns out of the public list by toggling it off.
  isPublic       Boolean        @default(true)
  authorId       String?
  author         User?          @relation(fields: [authorId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, sentAt])
  @@index([isPublic, sentAt])
}

// ---------- Blog ---------- //

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Post {
  id            String            @id @default(cuid())
  slug          String            @unique
  status        PostStatus        @default(DRAFT)
  authorId      String?
  author        User?             @relation(fields: [authorId], references: [id])
  coverImageUrl String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  translations  PostTranslation[]
  tags          PostTag[]

  @@index([status, publishedAt])
}

model PostTranslation {
  id      String  @id @default(cuid())
  postId  String
  locale  String
  title   String
  summary String?
  body    String  @db.Text

  /// Título para el <title> y el SERP, ≤60 caracteres. Si falta, se usa `title`.
  seoTitle        String?
  /// Meta description, 140-158 caracteres. Si falta, se usa `summary`.
  metaDescription String?
  /// Texto alternativo de la portada, en este idioma.
  coverImageAlt   String?
  /// [{ pregunta, respuesta }]. Se pinta como bloque visible y como JSON-LD
  /// de tipo FAQPage. Null = la pieza no tiene FAQ.
  faq             Json?
  /// [{ texto, destino }]. Enlaces a otras piezas del sitio, en este idioma.
  /// Se pintan como bloque "Seguir leyendo" al final. Null = sin enlaces.
  relatedLinks    Json?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([locale])
}

// ---------- News ---------- //

enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model News {
  id            String            @id @default(cuid())
  slug          String            @unique
  status        NewsStatus        @default(DRAFT)
  authorId      String?
  author        User?             @relation(fields: [authorId], references: [id])
  coverImageUrl String?
  externalUrl   String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  translations  NewsTranslation[]
  tags          NewsTag[]

  @@index([status, publishedAt])
}

model NewsTranslation {
  id      String  @id @default(cuid())
  newsId  String
  locale  String
  title   String
  summary String?
  body    String? @db.Text

  /// Título para el <title> y el SERP, ≤60 caracteres. Si falta, se usa `title`.
  seoTitle        String?
  /// Meta description, 140-158 caracteres. Si falta, se usa `summary`.
  metaDescription String?
  /// Texto alternativo de la portada, en este idioma.
  coverImageAlt   String?
  /// [{ pregunta, respuesta }]. Se pinta como bloque visible y como JSON-LD
  /// de tipo FAQPage. Null = la pieza no tiene FAQ.
  faq             Json?
  /// [{ texto, destino }]. Enlaces a otras piezas del sitio, en este idioma.
  /// Se pintan como bloque "Seguir leyendo" al final. Null = sin enlaces.
  relatedLinks    Json?

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, locale])
  @@index([locale])
}

// ---------- Events ---------- //

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventLocationType {
  ONLINE
  INPERSON
  HYBRID
}

enum RegistrationStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
  /// Inscripción a un evento de pago que aún no ha completado el pago en
  /// Kunfupay. No ocupa plaza ni recibe correo de confirmación hasta que
  /// llega el webhook payment.completed.
  PENDING_PAYMENT
}

/// Estado del cobro de una inscripción. null = el evento no se cobra online.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Event {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  status               EventStatus         @default(DRAFT)
  locationType         EventLocationType   @default(INPERSON)
  /// Formato recurrente al que pertenece la edición: "meetup", "table",
  /// "summit" o "ski". Es lo que permite que /meetup resuelva siempre la
  /// próxima edición sin cambiar la URL cada mes. null = evento suelto.
  series               String?
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String              @default("Europe/Andorra")
  venueName            String?
  venueAddress         String?
  onlineUrl            String?
  capacity             Int?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  coverImageUrl        String?
  /// Precio en céntimos. null = gratuito o sin precio publicado.
  priceCents           Int?
  /// Venta externa (Eventbrite, Stripe…). Si está, el CTA lleva ahí en vez
  /// de al formulario propio: permite cobrar sin montar pasarela.
  ticketUrl            String?
  /// Cobrar la inscripción online con Kunfupay usando priceCents. Si está
  /// activo, el formulario propio crea la inscripción pendiente de pago y
  /// redirige al checkout; la plaza se confirma con el webhook de Kunfupay.
  onlinePayment        Boolean             @default(false)
  /// Invitado de la edición. Es el mismo Guest del podcast a propósito: la
  /// regla editorial es que invitado de meetup = episodio. Nullable porque
  /// las ediciones sociales (navidad, verano) no llevan entrevista.
  guestId              String?
  guest                Guest?              @relation(fields: [guestId], references: [id], onDelete: SetNull)
  /// La edición no lleva invitado a propósito: el meetup navideño, un café en
  /// el que la mesa es el formato. Es distinto de guestId null, que significa
  /// «todavía no hay» y hace que la landing diga «por anunciar». Sin este
  /// campo los dos casos se veían igual y la web prometía un invitado que en
  /// las ediciones sociales no iba a llegar.
  noGuest              Boolean             @default(false)
  authorId             String?
  author               User?               @relation(fields: [authorId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  translations         EventTranslation[]
  registrations        EventRegistration[]
  emailSends           EventEmailSend[]
  presenters           EventPresenter[]

  @@index([status, startsAt])
  @@index([series, status, startsAt])
}

model EventTranslation {
  id          String  @id @default(cuid())
  eventId     String
  locale      String
  title       String
  summary     String?
  description String? @db.Text

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
  @@index([locale])
}

/// Empresa o proyecto que se presenta en un evento. Sale en la sección
/// «Presentan» de la página del evento, con su logo enlazado a la web o al
/// perfil que nos den. La descripción es contenido editorial: se traduce por
/// idioma y, si falta, se muestra la de castellano.
model EventPresenter {
  id           String                      @id @default(cuid())
  eventId      String
  name         String
  logoUrl      String?
  /// Web, Instagram, LinkedIn… Lo que nos den; es el destino del logo.
  url          String?
  /// Orden en la sección: de menor a mayor.
  position     Int                         @default(0)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  event        Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  translations EventPresenterTranslation[]

  @@index([eventId, position])
}

model EventPresenterTranslation {
  id          String @id @default(cuid())
  presenterId String
  locale      String
  description String @db.Text

  presenter EventPresenter @relation(fields: [presenterId], references: [id], onDelete: Cascade)

  @@unique([presenterId, locale])
}

model EventRegistration {
  id        String             @id @default(cuid())
  eventId   String
  email     String
  fullName  String
  company   String?
  notes     String?
  locale    String             @default("es")
  status    RegistrationStatus @default(CONFIRMED)
  createdAt DateTime           @default(now())

  /// Cobro online (Kunfupay). Todo null en eventos gratuitos.
  paymentStatus     PaymentStatus?
  /// Importe que se pidió, en céntimos, congelado al crear el checkout.
  amountCents       Int?
  /// Importe que Kunfupay notificó como cobrado, en céntimos.
  paidCents         Int?
  currency          String?
  /// Sesión de checkout más reciente. Las anteriores también confirman la
  /// inscripción porque el webhook se cruza por externalReference (= id).
  kunfupaySessionId String?   @unique
  /// Contador de intentos: forma parte de la Idempotency-Key de Kunfupay.
  paymentAttempts   Int       @default(0)
  paidAt            DateTime?
  /// Cuándo salió de verdad el correo de confirmación a la persona. null =
  /// no se ha enviado (o falló el SMTP): el admin lo marca y deja reenviarlo.
  confirmationEmailSentAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId, status])
}

/// Plantilla de correo para escribir a los inscritos de un evento. El asunto
/// y el cuerpo llevan huecos como {{nombre}} o {{evento}} que se rellenan con
/// los datos de cada persona; {{motivo}} recibe el texto libre de cada envío.
/// Una plantilla está escrita en un idioma: en él se formatean fecha y hora.
model EventEmailTemplate {
  id        String           @id @default(cuid())
  name      String
  locale    String           @default("es")
  subject   String
  body      String           @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sends     EventEmailSend[]
}

/// Registro de cada envío a los inscritos de un evento: qué se mandó, a
/// cuántas personas y quién lo hizo. No guarda el cuerpo de cada correo.
model EventEmailSend {
  id         String               @id @default(cuid())
  eventId    String
  templateId String?
  subject    String
  reason     String?              @db.Text
  /// Estados de inscripción a los que se envió; vacío = a una sola persona.
  statuses   RegistrationStatus[]
  recipients Int
  sent       Int
  failed     Int
  sentById   String?
  createdAt  DateTime             @default(now())

  event    Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template EventEmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sentBy   User?               @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
}

/// Bandeja de entrada de webhooks de Kunfupay. eventId es único: Kunfupay
/// entrega al menos una vez y reintenta, así que se deduplica aquí.
model KunfupayWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([eventType])
}

// ---------- Social publishing ---------- //

enum SocialProvider {
  LINKEDIN
  X
  INSTAGRAM
  TIKTOK
}

enum SocialPublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model SocialAccount {
  id            String                    @id @default(cuid())
  provider      SocialProvider
  /// External user/page id from the provider (e.g. "urn:li:person:..." for LinkedIn).
  externalId    String
  /// Display name shown in the admin (e.g. "Valira Valley · LinkedIn").
  displayName   String
  avatarUrl     String?
  accessToken   String                    @db.Text
  refreshToken  String?                   @db.Text
  /// null = never expires (rare).
  expiresAt     DateTime?
  scope         String?
  /// Soft-disconnect: keeps publication history attached to the account.
  isActive      Boolean                   @default(true)
  connectedById String?
  connectedBy   User?                     @relation(fields: [connectedById], references: [id])
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  targets       SocialPublicationTarget[]

  @@unique([provider, externalId])
  @@index([provider, isActive])
}

model SocialPublication {
  id          String                    @id @default(cuid())
  body        String                    @db.Text
  mediaUrls   String[]                  @default([])
  /// Permalink to the page on our site this announces (optional).
  sourceUrl   String?
  status      SocialPublicationStatus   @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  /// Optional informational links to the source content (not enforced).
  episodeId   String?
  postId      String?
  newsId      String?
  eventId     String?
  authorId    String?
  author      User?                     @relation(fields: [authorId], references: [id])
  targets     SocialPublicationTarget[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([status, scheduledAt])
}

/// One row per (publication, account). Stores the per-target outcome so
/// posting to LinkedIn can succeed while X fails on the same publication.
model SocialPublicationTarget {
  publicationId String
  accountId     String
  status        SocialPublicationStatus @default(DRAFT)
  /// Provider-side post id (e.g. LinkedIn URN).
  externalId    String?
  /// Public permalink to the post on the provider.
  externalUrl   String?
  attempts      Int                     @default(0)
  lastError     String?                 @db.Text
  publishedAt   DateTime?
  updatedAt     DateTime                @updatedAt

  publication SocialPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  account     SocialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([publicationId, accountId])
  @@index([accountId])
}

// ---------- Contact ---------- //

enum ContactTopic {
  SERVICES
  GUEST
  SPONSOR
  PRESS
  OTHER
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

/// Inbound messages from the public /contacto form. Stored (rather than
/// only emailed) so nothing is lost if the mail provider is down, and so
/// the admin can triage without living in an inbox.
model ContactRequest {
  id        String        @id @default(cuid())
  topic     ContactTopic  @default(OTHER)
  name      String
  email     String
  company   String?
  phone     String?
  message   String        @db.Text
  locale    String        @default("es")
  status    ContactStatus @default(NEW)
  /// Free-form internal notes for whoever handles the request.
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([topic, createdAt])
}

// ---------- Tags ---------- //

model Tag {
  id          String    @id @default(cuid())
  /// URL-safe identifier ("ia-andorra"). Unique.
  slug        String    @unique
  /// Default human-readable name.
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  posts       PostTag[]
  news        NewsTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model NewsTag {
  newsId String
  tagId  String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@index([tagId])
}
