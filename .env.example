# Database (PostgreSQL)
DATABASE_URL="postgresql://vvaley:CHANGE_ME@localhost:5432/vvaley?schema=public"

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_TO_A_RANDOM_STRING"

# Public URL of the site (used by Auth.js for callbacks).
# In development: http://localhost:3000
# In production:  https://valiravalley.com
NEXTAUTH_URL="http://localhost:3000"

# Initial admin user created by `pnpm prisma:seed`
SEED_ADMIN_EMAIL="admin@valiravalley.com"
SEED_ADMIN_PASSWORD="changeme"
SEED_ADMIN_NAME="Admin"

# Default locale and supported locales (kept in sync with src/i18n/routing.ts)
NEXT_PUBLIC_DEFAULT_LOCALE="es"

# Public site URL — used in newsletter emails and to build absolute
# links (canonicals, OpenGraph, sitemap, RSS). In production set this to
# the public origin (e.g. "https://valiravalley.com"). If left blank the
# code falls back to NEXTAUTH_URL.
PUBLIC_SITE_URL="https://valiravalley.com"

# Email provider (Resend). Without these vars the newsletter helper logs the
# confirmation/unsubscribe message to the server console (handy in dev).
RESEND_API_KEY=""
EMAIL_FROM="Valira Valley <noreply@valiravalley.com>"

# Social publishing — LinkedIn.
# Create a LinkedIn app at https://www.linkedin.com/developers/apps :
#  · enable "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
#  · add the redirect URL: ${PUBLIC_SITE_URL}/api/social/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# X (Twitter). Create an app at https://developer.x.com/en/portal/dashboard
#  · enable OAuth 2.0 (Confidential client)
#  · scopes: tweet.read tweet.write users.read offline.access
#  · redirect: ${PUBLIC_SITE_URL}/api/social/x/callback
# Note: write endpoints require Basic tier ($100/month) in production.
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Instagram (via Meta Graph API). Create a Business app at
# https://developers.facebook.com — add the "Instagram Graph API" product.
# The IG account must be Professional and linked to a Facebook Page.
# Required permissions (subject to Meta App Review):
#  · pages_show_list
#  · pages_read_engagement
#  · instagram_basic
#  · instagram_content_publish
# Redirect: ${PUBLIC_SITE_URL}/api/social/instagram/callback
META_APP_ID=""
META_APP_SECRET=""

# TikTok. Create an app at https://developers.tiktok.com — add the
# "Login Kit" and "Content Posting API" products. Until your app passes
# TikTok's review, video.publish only works for the developer's own
# account and posts may land as private drafts.
# Scopes: user.info.basic, video.publish
# Redirect: ${PUBLIC_SITE_URL}/api/social/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Shared secret used by deploy/vvaley-cron.service to call
# /api/admin/social/process-queue. Generate with: openssl rand -base64 32
# Without this var the queue endpoint refuses to run.
CRON_SECRET=""

# Where inbound messages from the public /contacto form are notified.
# The submission is always stored in the DB, so a missing value here only
# means nobody gets an email nudge — check /admin/contacto instead.
CONTACT_NOTIFY_EMAIL=""

# Analytics (privacy-friendly, optional). Configure ONE provider — when set,
# the public site loads the corresponding script. Leave both blank to ship
# without analytics.
#
# Plausible: PLAUSIBLE_DOMAIN is the property domain configured in your
# Plausible dashboard (e.g. "valiravalley.com"). PLAUSIBLE_SCRIPT_URL is
# optional; set it to point at a self-hosted instance.
PLAUSIBLE_DOMAIN=""
PLAUSIBLE_SCRIPT_URL=""

# Umami: both vars required.
UMAMI_WEBSITE_ID=""
UMAMI_SCRIPT_URL=""
